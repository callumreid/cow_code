{
  "display_information": { "name": "cow", "description": "the farmer's office, in slack", "background_color": "#2a7a4b" },
  "features": {
    "bot_user": { "display_name": "cow", "always_online": true },
    "app_home": { "messages_tab_enabled": true, "messages_tab_read_only_enabled": false }
  },
  "oauth_config": {
    "scopes": { "bot": ["app_mentions:read", "chat:write", "im:history", "im:read", "im:write", "channels:history", "groups:history", "reactions:write", "users:read"] }
  },
  "settings": {
    "event_subscriptions": { "bot_events": ["app_mention", "message.im"] },
    "interactivity": { "is_enabled": false },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}

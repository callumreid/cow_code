<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>dev.bronson.claude-rc</string>
<key>ProgramArguments</key><array><string>/Users/bronson/bin/claude-rc.sh</string></array>
<!-- SessionCreate: without a security session, a launchd-started claude cannot see the claude.ai login -->
<key>SessionCreate</key><true/>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/>
<key>ThrottleInterval</key><integer>20</integer>
<key>StandardOutPath</key><string>/Users/bronson/Library/Logs/claude-rc.launchd.log</string>
<key>StandardErrorPath</key><string>/Users/bronson/Library/Logs/claude-rc.launchd.log</string>
</dict></plist>

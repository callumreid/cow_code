{
  "display_information": {
    "name": "cowcode",
    "description": "mention it in a channel to hand it work; DM it for the farmer",
    "background_color": "#2a7a4b"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "cowcode",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "user": [
        "search:read",
        "channels:history",
        "groups:history",
        "im:history",
        "channels:read",
        "groups:read",
        "im:read",
        "mpim:history",
        "mpim:read",
        "users:read",
        "chat:write",
        "im:write"
      ],
      "bot": [
        "app_mentions:read",
        "channels:history",
        "chat:write",
        "groups:history",
        "im:history",
        "im:read",
        "im:write",
        "reactions:write",
        "users:read"
      ]
    },
    "pkce_enabled": false
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.im"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "is_mcp_enabled": false,
    "token_rotation_enabled": false,
    "app_level_token_rotation_enabled": false
  }
}
